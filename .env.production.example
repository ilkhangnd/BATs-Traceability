POSTGRES_PASSWORD=replace-with-a-strong-database-password
SESSION_SECRET=replace-with-at-least-32-random-characters
ADMIN_EMAIL=admin@bats.vn
ADMIN_PASSWORD=replace-with-a-strong-admin-password
WEB_ORIGINS=https://bats.example.vn
PUBLIC_API_URL=https://api.bats.example.vn
BUSINESS_TIMEZONE=Asia/Ho_Chi_Minh
API_PORT=4000
WEB_PORT=3000
OPENAPI_ENABLED=true
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000
TRUST_PROXY=true

# Optional until a managed/public blockchain signer is configured.
CHAIN_RPC_URL=
ANCHOR_CONTRACT_ADDRESS=
ANCHOR_PRIVATE_KEY=
ANCHOR_SCHEDULER_ENABLED=false
ANCHOR_SCHEDULER_INTERVAL_MS=300000
ANCHOR_RETRY_BASE_MS=60000
ANCHOR_RETRY_MAX_MS=86400000

# Optional Google Maps production configuration.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAP_ID=
