  "private": true,
  "type": "module",
  "main": "./dist/offline-queue.js",
  "types": "./dist/offline-queue.d.ts",
  "dependencies": {
    "lucide-react": "^1.16.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
