generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Actor {
  id           String     @id
  name         String
  email        String?    @unique
  phone        String?
  zaloUserId   String?    @unique @map("zalo_user_id")
  role         String
  organization String?
  status       String     @default("active")
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")
  auditLogs    AuditLog[]

  @@map("actors")
}

model FarmPlot {
  id               String   @id
  farmerId         String   @map("farmer_id")
  farmerName       String   @map("farmer_name")
  plantingAreaCode String   @unique @map("planting_area_code")
  crop             String
  variety          String
  areaHa           Decimal  @map("area_ha") @db.Decimal(12, 4)
  province         String
  district         String
  commune          String
  polygonGeoJson   Json     @map("polygon_geojson")
  polygon          Unsupported("geometry(Polygon, 4326)")
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")
  batches          Batch[]

  @@index([status])
  @@index([farmerId])
  @@map("farm_plots")
}

model Batch {
  id          String             @id
  gtin        String
  lot         String
  serial      String
  farmPlotId  String             @map("farm_plot_id")
  farmerId    String             @map("farmer_id")
  crop        String
  variety     String
  quantityKg  Decimal            @map("quantity_kg") @db.Decimal(14, 3)
  status      String
  riskScore   Int                @default(0) @map("risk_score")
  riskBand    String             @default("green") @map("risk_band")
  accepted    Boolean            @default(true)
  issues      Json
  createdAt   DateTime           @default(now()) @map("created_at")
  updatedAt   DateTime           @updatedAt @map("updated_at")
  farmPlot    FarmPlot           @relation(fields: [farmPlotId], references: [id])
  events      EpcisEvent[]
  validations ValidationResult[]

  @@unique([gtin, lot, serial])
  @@index([farmPlotId, createdAt])
  @@index([status])
  @@map("batches")
}

model EpcisEvent {
  id        String         @id
  batchId   String         @map("batch_id")
  eventType String         @map("event_type")
  status    String
  eventTime DateTime       @map("event_time")
  actorId   String         @map("actor_id")
  payload   Json
  eventHash String         @unique @map("event_hash")
  createdAt DateTime       @default(now()) @map("created_at")
  batch     Batch          @relation(fields: [batchId], references: [id], onDelete: Cascade)
  evidence  EvidenceFile[]

  @@index([eventTime])
  @@index([batchId, eventTime])
  @@map("epcis_events")
}

model EvidenceFile {
  id          String     @id @default(uuid()) @db.Uuid
  eventId     String?    @map("event_id")
  sha256      String     @unique
  type        String
  storageRef  String     @map("storage_ref")
  mimeType    String?    @map("mime_type")
  sizeBytes   BigInt?    @map("size_bytes")
  createdAt   DateTime   @default(now()) @map("created_at")
  event       EpcisEvent? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@map("evidence_files")
}

model ValidationResult {
  id        String   @id @default(uuid()) @db.Uuid
  batchId   String   @map("batch_id")
  eventId   String?  @map("event_id")
  score     Int
  band      String
  accepted  Boolean
  issues    Json
  ruleSet   String   @map("rule_set")
  createdAt DateTime @default(now()) @map("created_at")
  batch     Batch    @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@index([batchId, createdAt])
  @@map("validation_results")
}

model Anchor {
  id            String   @id @default(uuid()) @db.Uuid
  batchDate     DateTime @unique @map("batch_date") @db.Date
  merkleRoot    String   @map("merkle_root")
  schemaVersion String   @map("schema_version")
  chainId       String?  @map("chain_id")
  contract      String?  @map("contract_address")
  txHash        String?  @map("tx_hash")
  blockNumber   BigInt?  @map("block_number")
  status        String   @default("pending")
  attemptCount  Int      @default(0) @map("attempt_count")
  lastError     String?  @map("last_error")
  nextAttemptAt DateTime? @map("next_attempt_at")
  anchoredAt    DateTime? @map("anchored_at")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  @@index([status])
  @@index([status, nextAttemptAt])
  @@map("anchors")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Uuid
  actorId    String   @map("actor_id")
  action     String
  targetType String   @map("target_type")
  targetId   String   @map("target_id")
  metadata   Json?
  createdAt  DateTime @default(now()) @map("created_at")
  actor      Actor    @relation(fields: [actorId], references: [id])

  @@index([targetType, targetId])
  @@index([createdAt])
  @@map("audit_logs")
}

model IdempotencyKey {
  key          String   @id
  actorId      String   @map("actor_id")
  endpoint     String
  requestHash  String   @map("request_hash")
  status       String   @default("processing")
  responseCode Int?     @map("response_code")
  responseBody Json?    @map("response_body")
  expiresAt    DateTime @map("expires_at")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([expiresAt])
  @@map("idempotency_keys")
}
