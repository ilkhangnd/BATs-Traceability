{
  "name": "@bats/backend",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "nest build",
    "db:deploy": "cd ../.. && apps/backend/node_modules/.bin/prisma migrate deploy --schema apps/backend/prisma/schema.prisma",
    "db:generate": "cd ../.. && apps/backend/node_modules/.bin/prisma generate --schema apps/backend/prisma/schema.prisma",
    "db:seed": "cd ../.. && node --env-file=.env apps/backend/prisma/seed.mjs",
    "db:status": "cd ../.. && apps/backend/node_modules/.bin/prisma migrate status --schema apps/backend/prisma/schema.prisma",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "test": "vitest run",
    "test:e2e": "vitest run src/workflow.e2e.spec.ts",
    "test:integration": "RUN_DB_TESTS=1 node --env-file-if-exists=../../.env node_modules/vitest/vitest.mjs run src/store.service.integration.spec.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@bats/shared-types": "workspace:*",
    "@nestjs/common": "^11.1.3",
    "@nestjs/core": "^11.1.3",
    "@nestjs/platform-express": "^11.1.3",
    "@nestjs/swagger": "^11.4.5",
    "@prisma/client": "^6.10.1",
    "ethers": "^6.14.4",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.7",
    "@nestjs/testing": "^11.1.27",
    "@types/node": "^22.15.30",
    "@types/supertest": "^7.2.0",
    "prisma": "^6.10.1",
    "supertest": "^7.2.2",
    "typescript": "^5.8.3",
    "vitest": "^3.2.3"
  }
}
